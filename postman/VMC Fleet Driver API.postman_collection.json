{
  "info": {
    "_postman_id": "aa43e6f4-4d61-4d9d-b420-24fc0478ed95",
    "name": "VMC Fleet Driver API",
    "description": "Mobile API requests for VMC vehicle drivers. Set base_url to the running Laravel API (for example http://127.0.0.1:8000), set driver_email and driver_password, then run Login first. The login request stores the Sanctum token for the other requests. Fleet APIs only return work and notifications belonging to the authenticated driver.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "driver_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "assignment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicle_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"{{driver_password}}\",\n  \"device_name\": \"VMC Driver App\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates an active user and stores the returned Sanctum bearer token in the collection variable access_token."
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated user's profile, roles, permissions, and station access."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current Sanctum token. Run Login again before sending other authenticated requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Fleet",
      "item": [
        {
          "name": "List My Active Assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Assignments request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) {",
                  "        pm.collectionVariables.set('assignment_id', records[0].id);",
                  "        if (records[0].job && records[0].job.id) pm.collectionVariables.set('job_id', records[0].job.id);",
                  "        if (records[0].vehicle && records[0].vehicle.id) pm.collectionVariables.set('vehicle_id', records[0].vehicle.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/assignments?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "assignments"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns active assignments for the signed-in driver. The test script stores the first assignment, job, and vehicle IDs when present."
          },
          "response": []
        },
        {
          "name": "List My Assigned Vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicles request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) pm.collectionVariables.set('vehicle_id', records[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/vehicles?per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "vehicles"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns only vehicles on the driver's active assignments."
          },
          "response": []
        },
        {
          "name": "List Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notifications request succeeds', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const records = pm.response.json().data || [];",
                  "    if (records.length > 0) pm.collectionVariables.set('notification_id', records[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/notifications?unread_only=1&per_page=15&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "notifications"
              ],
              "query": [
                {
                  "key": "unread_only",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Returns the authenticated driver's notification inbox. Set unread_only to 0 to include read notifications."
          },
          "response": []
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fleet/notifications/{{notification_id}}/read",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fleet",
                "notifications",
                "{{notification_id}}",
                "read"
              ]
            },
            "description": "Marks a notification belonging to the authenticated driver as read. Send List Notifications first to populate notification_id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Assignment Status and GPS",
      "item": [
        {
          "name": "Update Assignment Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"remarks\": \"DEMO DRILL: Continue response\",\n  \"latitude\": 22.3101,\n  \"longitude\": 73.1841\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/jobs/{{job_id}}/assignments/{{assignment_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "{{job_id}}",
                "assignments",
                "{{assignment_id}}",
                "status"
              ]
            },
            "description": "Updates an assignment status. Allowed values: EN_ROUTE, ARRIVED, IN_PROGRESS, COMPLETED. job_id is the numeric job.id from List My Active Assignments, not the public job reference."
          },
          "response": []
        },
        {
          "name": "Send Vehicle GPS Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignment_id\": \"{{assignment_id}}\",\n  \"latitude\": 22.3101,\n  \"longitude\": 73.1841,\n  \"speed_kph\": 28.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}/gps",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicles",
                "{{vehicle_id}}",
                "gps"
              ]
            },
            "description": "Records a GPS point for the specified active assignment. Coordinates are decimal degrees; recorded_at is optional and must be within the last 24 hours and no more than five minutes in the future."
          },
          "response": []
        },
        {
          "name": "Get Vehicle GPS History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vehicles/{{vehicle_id}}/gps?assignment_id={{assignment_id}}&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicles",
                "{{vehicle_id}}",
                "gps"
              ],
              "query": [
                {
                  "key": "assignment_id",
                  "value": "{{assignment_id}}"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Returns GPS route history for this vehicle and assignment. Optional from/to timestamps and limit (1–500) may be supplied. Route history is restricted to the authorized user's access."
          },
          "response": []
        }
      ]
    }
  ]
}
